# Contraseña para entrar a la app (la comparten las personas que la usan).
APP_PASSWORD=

# Texto largo y aleatorio para firmar las sesiones. Si falta, las sesiones se
# cierran cada vez que el servidor se reinicia.
SESSION_SECRET=

# Tienda de Makro de la que se toman los precios (194 / 22Val = Valledupar).
MAKRO_STORE_ID=194
MAKRO_STORE_REF=22Val

# Notificaciones push (opcional). Créalas con `npm run claves-push`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Avisos por WhatsApp al dueño (opcional). Una de las dos:
# a) Green-API (green-api.com), escaneando un QR con el WhatsApp de la empresa.
GREENAPI_ID=
GREENAPI_TOKEN=
# GREENAPI_URL=https://api.green-api.com
# b) API oficial de Meta (WhatsApp Cloud API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
